                                <stop offset="0%" stop-color="#78F8EC" />
                                <stop offset="100%" stop-color="#6E4AE2" />
                            </linearGradient>
                            <circle pathLength="100" cx="50" cy="50" r="50" stroke-dasharray="100"
                                stroke="url(#gradient)" stroke-width="8" fill="none" transform="rotate(90 50 50)" mask="url(#circleMask)"/>
                            <mask id="circleMask">
                                <circle pathLength="100" cx="50" cy="50" r="50" stroke-dasharray="1" stroke="#fff"
                                        stroke-width="12" fill="none" />
                            </mask>
