<html lang="fr" translate="no">
<%- include("partials/head", {
    title: "MJ Menu",
    cssFiles:[
        "/css/style.css",
        "/css/mj-menu.css"
    ]
}) %>

<body>
<%- include("partials/nav") %>
    <div class="center">
        <div class="overflownt">
            <div class="flex-container">
                <div class="choice-reveal">
                    <div class="desc-container choice">
                        <div class="desc-title">&nbsp;&nbsp;<span class="blackout">Blackout</span>&nbsp;-&nbsp;<span class="mjreveal">Infos-MJ</span><br><br>&nbsp;&nbsp;&nbsp;Description de la carte actuelle :
                        </div>
                        <div class="desc-text">Ici serra présenté le texte descriptif de la carte actuelle, certaines informations ne seront visible qu'ici !</div>
                    </div>
                    <% for(var i=0; i<3; i++) {%>
                    <div class="choice" id="choice<%= i %>">
                        <div class="button-text">Ici serront présentés les choix. <span class="blackout">Les choix pendant un blackout.</span></div>
                        <div class="reveal-text">Ici serra présenté le texte révélé après avoir cliqué sur le choix.<span class="blackout">&nbsp;Les outcome pendant un blackout,</span><span class="mjreveal"> et les informations complémentaires.</span></div>
                    </div>
                    <% } %>
                </div>
                <div class="life-container">
                    <div class="life-change">
                        <div class="life-type1">
                            <input class="life-input" type="radio" name="life" id="life-1" value="0" checked>
                            <label class="life-label" for="life-1">Adversaires</label>
                        </div>
                        <div class="life-type2">
                            <input class="life-input" type="radio" name="life" id="life-2" value="1">
                            <label class="life-label" for="life-2">Compagnons</label>
                        </div>
                        <div class="life-selector">
                            <div class="ennemy">
                                <input type="text" id="search-ennemy" list="bestiaire" placeholder="Adversaire">
                                <datalist id="bestiaire">
                                    <!--Oui les ennemis c'est là dedans probablement un menu avec scroll bar et ce serait giga cool une barre de recherche-->
                                    <option value="mob1"></option>
                                    <option value="mob2"></option>
                                    <option value="mob3"></option>
                                    <option value="mob4"></option>
                                    <option value="mob5"></option>
                                    <option value="monstre1"></option>
                                    <option value="monstre2"></option>
                                    <option value="monstre3"></option>
                                    <option value="monstre4"></option>
                                </datalist>
                                <button class="add-life" id="add-monstre">+</button>
                                <button class="add-life" id="monstre-list">x</button>
                            </div>
                            <div class="ally hide">
                                <input type="text" id="search-ally" list="compagnon" placeholder="Compagnon">
                                <datalist id="compagnon">
                                    <!--Oui les compagnons/alliés c'est là dedans probablement un menu avec scroll bar et ce serait giga cool une barre de recherche-->
                                    <option value="ally1"></option>
                                    <option value="ally2"></option>
                                    <option value="ally3"></option>
                                    <option value="ally4"></option>
                                    <option value="ally5"></option>
                                    <option value="friend1"></option>
                                    <option value="friend2"></option>
                                    <option value="friend3"></option>
                                    <option value="friend4"></option>
                                </datalist>
                                <button class="add-life" id="add-friend">+</button>
                                <button class="add-life" id="friend-list">x</button>
                            </div>
                        </div>
                    </div>
                    <div class="status-box">
                        <input class="add-life status-search" type="text" id="search-status" list="status" placeholder="Status">
                        <datalist id="status">
                            <option value="blackout"></option>
                            <option value="anticipation"></option>
                            <option value="wanted"></option>
                            <option value="weak"></option>
                        </datalist>
                        <input type="number" min="0" max="10" class="add-life status-duration-text" id="duration-status" placeholder="0"></input>
                        <button class="add-life" id="add-status">+</button>
                    </div>
                </div>
                <div class="combat">
                    <!--Un espace pour chaque joueurs pour un boutton join-->
                    <button class="add-life fight" id="combat-start"> Commencer le combat</button>
                    <div id="console-container">
                        <div class="life-change">Choix du type de roll : <br>
                            <div class="empty-for-flex"></div>
                            <div class="mjroll-type">
                                <input class="mjroll-input" type="radio" name="mjroll" id="mjroll1" value="0" checked>
                                <label class="mjroll-label" for="mjroll1">Faible: 1-4</label>
                            </div>
                            <div class="mjroll-type">
                                <input class="mjroll-input" type="radio" name="mjroll" id="mjroll2" value="1">
                                <label class="mjroll-label" for="mjroll2">Moyen: 5-8</label>
                            </div>
                            <div class="mjroll-type">
                                <input class="mjroll-input" type="radio" name="mjroll" id="mjroll3" value="2">
                                <label class="mjroll-label" for="mjroll3">Fort: 9-12</label>
                            </div>
                            <div class="mjroll-type">
                                <input class="mjroll-input" type="checkbox" name="mjroll-module" id="mjroll-module">
                                <label class="mjroll-label" for="mjroll-module">Module (Moral par défaut)</label>
                            </div>
                        </div>
                        <div class="player-roll">
                            <div class="player-stat-value" id="mjroll-button">Roll</div>
                            <div class="output-roll" id="mjroll-roll">00</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="js/socketLNOB.js"></script>
<script src="js/mj-menu.js"></script>
<%- include("partials/bottom-scripts") %>
</body>