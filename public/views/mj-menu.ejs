<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1, minimum-scale=1">
    <link rel="stylesheet" href="css\style.css">
    <link rel="stylesheet" href="css\mj-menu.css">
</head>

<body>
    <%- include("partials/nav") %>
    <div class="center">
        <div class="flex-container">
            <div class="choice-reveal">
                <% for(var i=0; i<3; i++) {%>
                    <div class="choice" id="choice<%= i %>">
                        <div class="button-text">Lorem ipsum dolor sit amet consectetur adipisicing elit. </div>
                        <div class="reveal-text">Lorem ipsum dolor sit amet consectetur adipisicing elit. Animi sunt quae dolorem dignissimos, beatae nesciunt sint tenetur eaque assumenda. Officia, cumque! Provident neque doloribus cumque ipsa eius consectetur aut libero? </div>
                    </div>
                    <% } %>
            </div>
            <div class="life-container">
                <div class="ennemy">
                    <input type="text" id="search-ennemy" list="bestiaire" placeholder="Adversaire">
                    <datalist id="bestiaire">
                        <!--Oui les ennemis c'est là dedans probablement un menu avec scroll bar et ce serait giga cool une barre de recherche-->
                        <option value="mob1"></option>
                        <option value="mob2"></option>
                        <option value="mob3"></option>
                        <option value="mob4"></option>
                        <option value="mob5"></option>
                        <option value="monstre1"></option>
                        <option value="monstre2"></option>
                        <option value="monstre3"></option>
                        <option value="monstre4"></option>
                    </datalist>
                    <button class="add-life" id="add-monstre">+</button>
                    <button class="add-life" id="monstre-list" >X</button>
                </div>
                <div class="ally">
                    <input type="text" id="search-ally" list="compagnon" placeholder="Compagnon">
                    <datalist id="compagnon">
                        <!--Oui les compagnons/alliés c'est là dedans probablement un menu avec scroll bar et ce serait giga cool une barre de recherche-->
                        <option value="ally1"></option>
                        <option value="ally2"></option>
                        <option value="ally3"></option>
                        <option value="ally4"></option>
                        <option value="ally5"></option>
                        <option value="friend1"></option>
                        <option value="friend2"></option>
                        <option value="friend3"></option>
                        <option value="friend4"></option>
                    </datalist>
                    <button class="add-life" id="add-friend">+</button>
                    <button class="add-life" id="friend-list" >X</button>
                </div>
            </div>
            <div class="combat">
                <!--Un espace pour chaque joueurs pour un boutton join-->
                <button class="add-life fight" id="combat-start"> Commencer le combat</button>
                <div id="console-container"> Texte

                </div>
            </div>
        </div>
    </div>
    
</body>
<script src="js/mj-menu.js"></script>