<html lang="fr" translate="no">
<%- include("partials/head", {
    title: "MJ Menu",
    cssFiles:[
        "/css/style.css",
        "/css/mj-menu.css",
        "/css/ui-menus.css",
        "/css/ship-alerts.css",
        "/css/mj-ship.css",
        "/css/mj-shop.css",
        "/css/mj-craft.css"
    ]
}) %>

<body class="mj-page">
<%- include("partials/nav") %>
    <div class="center">
        <div class="overflownt">
            <div class="flex-container">
                <div class="choice-reveal">
                    <div class="desc-container choice">
                        <div class="desc-title">&nbsp;&nbsp;<span class="blackout">Blackout</span>&nbsp;-&nbsp;<span class="mjreveal">Infos-MJ</span><br><br>&nbsp;&nbsp;&nbsp;Description de la carte actuelle :
                        </div>
                        <div class="desc-mjreveal"></div>
                        <div class="desc-text">Ici serra présenté le texte descriptif de la carte actuelle, certaines informations ne seront visible qu'ici !</div>
                    </div>
                    <% for(var i=0; i<3; i++) {%>
                    <div class="choice" id="choice<%= i %>">
                        <div class="button-text">Ici serront présentés les choix. <span class="blackout">Les choix pendant un blackout.</span></div>
                        <div class="mjreveal-text"></div>
                        <div class="reveal-text">Ici serra présenté le texte révélé après avoir cliqué sur le choix.<span class="blackout">&nbsp;Les outcome pendant un blackout,</span><span class="mjreveal"> et les informations complémentaires.</span></div>
                    </div>
                    <% } %>
                </div>
                <div class="life-container">
                    <div class="life-change">
                        <div class="life-type1">
                            <input class="life-input" type="radio" name="life" id="life-1" value="0" checked>
                            <label class="life-label" for="life-1">Adversaires</label>
                        </div>
                        <div class="life-type2">
                            <input class="life-input" type="radio" name="life" id="life-2" value="1">
                            <label class="life-label" for="life-2">Compagnons</label>
                        </div>
                        <div class="life-selector">
                            <div class="ennemy">
                                <input type="text" id="search-ennemy" list="bestiaire" placeholder="Adversaire">
                                <datalist id="bestiaire">
                                    <% (locals.bestiary || []).forEach(function(mob) { %>
                                    <option value="<%= mob.name %>"><%= {invocation: 'Invocation', sbire: 'Sbire', elite: 'Élite', boss: 'Boss'}[mob.category] || '' %></option>
                                    <% }); %>
                                </datalist>
                                <button class="add-life" id="add-monstre">+</button>
                                <button class="add-life" id="monstre-list">x</button>
                            </div>
                            <div class="ally hide">
                                <input type="text" id="search-ally" list="compagnons" placeholder="Nom du compagnon" maxlength="20">
                                <datalist id="compagnons">
                                    <% (locals.companions || []).forEach(function(c) { %>
                                    <option value="<%= c.name %>"><%= c.race %></option>
                                    <% }); %>
                                </datalist>
                                <button class="add-life" id="add-friend">+</button>
                                <button class="add-life" id="friend-list">x</button>
                            </div>
                        </div>
                    </div>
                    <div class="mj-enemies" id="mj-enemies"></div>
                    <div class="mj-allies hide" id="mj-allies"></div>
                    <div class="status-box">
                        <input class="add-life status-search" type="text" id="search-status" list="status" placeholder="Status">
                        <datalist id="status">
                            <% (locals.statuses || []).forEach(function(status) { %>
                            <option value="<%= status.slug %>"><%= status.name %></option>
                            <% }); %>
                        </datalist>
                        <input type="number" min="1" max="10" class="add-life status-duration-text" id="duration-status" placeholder="1">
                        <button class="add-life" id="add-status">+</button>
                    </div>
                    <div class="mj-statuses" id="mj-statuses"></div>
                </div>
                <div class="combat">
                    <!--Un espace pour chaque joueurs pour un boutton join-->
                    <button class="add-life fight" id="combat-start">Commencer le combat</button>
                    <div class="mj-team" id="mj-team"></div>
                    <div class="mj-status-panel hide" id="mj-status-panel"></div>
                    <div class="mj-combat-log" id="mj-combat-log"></div>
                    <!-- Jet à la place d'un joueur (AFK, pas de moyen de lancer) : même chemin que /roll -->
                    <div class="mj-player-roll" id="mj-player-roll">
                        <div class="mj-team-title">Jet pour un joueur</div>
                        <div class="mj-player-roll-fields">
                            <select class="add-life" id="mj-player-roll-player" title="Joueur"></select>
                            <select class="add-life" id="mj-player-roll-stat" title="Stat">
                                <option value="combat">Combat</option>
                                <option value="pilotage">Pilotage</option>
                                <option value="engineering">Ingénierie</option>
                                <option value="survival">Survie</option>
                                <option value="recon">Reconnaissance</option>
                            </select>
                            <select class="add-life" id="mj-player-roll-module" title="Module">
                                <option value="">Sans module</option>
                                <option value="scanner">Scanners de surface</option>
                                <option value="proximity">Détecteurs de proximité</option>
                                <option value="motors">Moteurs</option>
                                <option value="oxygen">Module d'Oxygène</option>
                                <option value="energy">Electricité</option>
                                <option value="gravity">Gravité Artificielle</option>
                            </select>
                            <button type="button" class="add-life" id="mj-player-roll-send">Lancer</button>
                        </div>
                        <div class="mj-player-roll-result" id="mj-player-roll-result"></div>
                    </div>
                    <div id="console-container">
                        <div class="life-change">Choix du type de roll : <br>
                            <div class="empty-for-flex"></div>
                            <div class="mjroll-type">
                                <input class="mjroll-input" type="radio" name="mjroll" id="mjroll1" value="0" checked>
                                <label class="mjroll-label" for="mjroll1">Faible: 1-4</label>
                            </div>
                            <div class="mjroll-type">
                                <input class="mjroll-input" type="radio" name="mjroll" id="mjroll2" value="1">
                                <label class="mjroll-label" for="mjroll2">Moyen: 5-8</label>
                            </div>
                            <div class="mjroll-type">
                                <input class="mjroll-input" type="radio" name="mjroll" id="mjroll3" value="2">
                                <label class="mjroll-label" for="mjroll3">Fort: 9-12</label>
                            </div>
                            <div class="mjroll-type">
                                <input class="mjroll-input" type="checkbox" name="mjroll-module" id="mjroll-module">
                                <label class="mjroll-label" for="mjroll-module">Module (Moral par défaut)</label>
                            </div>
                        </div>
                        <div class="player-roll">
                            <div class="player-stat-value" id="mjroll-button">Roll</div>
                            <div class="output-roll" id="mjroll-roll">00</div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Plan du vaisseau : salles qui clignotent et alertes chez les joueurs (mj-ship.js) -->
            <section class="mj-ship" id="mj-ship">
                <div class="mj-ship-map" id="mj-ship-map">
                    <img src="/img/plan-plugs-stroke.png" alt="">
                    <%- include("partials/ship-rooms-svg") %>
                </div>
                <div class="mj-ship-controls">
                    <div class="mj-ship-title">Plan du vaisseau</div>
                    <p class="mj-ship-help">Cliquez sur une salle (plan ou liste) pour la faire clignoter chez les joueurs.</p>
                    <label class="mj-ship-toggle">
                        <input type="checkbox" id="mj-ship-show">
                        <span>Afficher le plan chez les joueurs</span>
                    </label>
                    <div class="mj-ship-rooms" id="mj-ship-rooms"></div>
                    <button type="button" class="add-life mj-ship-clear" id="mj-ship-clear">Tout éteindre</button>
                    <div class="mj-ship-alert-box">
                        <div class="mj-ship-subtitle">Alerte</div>
                        <select id="mj-ship-alert-room" class="add-life">
                            <% (locals.shipRooms || []).forEach(function(room) { %>
                            <option value="<%= room.id %>"><%= room.name %></option>
                            <% }); %>
                        </select>
                        <input type="text" id="mj-ship-alert-message" class="add-life" maxlength="120" placeholder="Message (ex : Brèche dans la coque !)">
                        <div class="mj-ship-alert-buttons">
                            <button type="button" class="add-life fight" id="mj-ship-alert-send">Envoyer l'alerte</button>
                            <button type="button" class="add-life" id="mj-ship-alert-stop" disabled>Arrêter l'alerte</button>
                        </div>
                        <div class="mj-ship-alert-status" id="mj-ship-alert-status">Aucune alerte en cours</div>
                    </div>
                </div>
            </section>
            <!-- Marchand et bourses (mj-shop.js) -->
            <section class="mj-shop" id="mj-shop">
                <div class="mj-shop-col">
                    <div class="mj-shop-head">
                        <div class="mj-ship-title">Marchand</div>
                        <span class="mj-shop-state" id="mj-shop-state">Boutique fermée</span>
                    </div>
                    <input type="text" id="mj-shop-name" class="add-life" maxlength="40" placeholder="Nom du marchand (ex. Walt DiFnek)">
                    <div class="mj-shop-stock-head"><span>Objet</span><span>Prix</span><span></span><span>Stock</span><span></span><span></span></div>
                    <div class="mj-shop-stock" id="mj-shop-stock"></div>
                    <div class="mj-shop-add" id="mj-shop-add-box">
                        <input type="text" id="mj-shop-item" class="add-life" list="mj-shop-items" maxlength="60" placeholder="Ajouter un objet à l'étal">
                        <button type="button" class="add-life" id="mj-shop-add" title="Ajouter à l'étal">+</button>
                        <button type="button" class="add-life" id="mj-shop-fill" title="Ajoute tous les objets qui ont un prix dans l'éditeur d'objets">Objets à prix</button>
                    </div>
                    <datalist id="mj-shop-items"></datalist>
                    <div class="mj-shop-pay">
                        <label>Acheteur <select id="mj-shop-buyer" class="add-life"></select></label>
                        <label>Paiement <select id="mj-shop-pay" class="add-life"><option value="credits">Monnaie</option><option value="cryopods">Cryopods</option></select></label>
                    </div>
                    <div class="mj-shop-actions">
                        <button type="button" class="add-life fight" id="mj-shop-open">Ouvrir la boutique</button>
                        <button type="button" class="add-life" id="mj-shop-close" disabled>Fermer la boutique</button>
                    </div>
                    <div class="mj-shop-msg" id="mj-shop-msg" role="status"></div>
                </div>
                <div class="mj-shop-col">
                    <div class="mj-ship-subtitle">Bourses</div>
                    <div class="mj-shop-wallets" id="mj-shop-wallets"></div>
                    <div class="mj-shop-cryopods" id="mj-shop-cryopods"></div>
                    <div class="mj-ship-subtitle">Vendre au marchand</div>
                    <label class="mj-shop-seller">Vendeur <select id="mj-shop-seller" class="add-life"></select></label>
                    <div class="mj-shop-sell" id="mj-shop-sell"></div>
                    <div class="mj-ship-subtitle">Journal</div>
                    <div class="mj-shop-log" id="mj-shop-log"></div>
                </div>
            </section>

            <!-- Atelier d'artisanat (mj-craft.js) -->
            <section class="mj-craft" id="mj-craft">
                <div class="mj-craft-col">
                    <div class="mj-shop-head">
                        <div class="mj-ship-title">Atelier</div>
                        <span class="mj-craft-state" id="mj-craft-state">Moment calme</span>
                    </div>
                    <p class="mj-ship-help">On fabrique dans le vaisseau, pendant un moment calme. Les ingrédients sont pris dans l'inventaire de l'artisan, qui reçoit l'objet.</p>
                    <div class="mj-craft-settings">
                        <label>Artisan <select id="mj-craft-crafter" class="add-life"></select></label>
                        <label>Armurerie <select id="mj-craft-armory" class="add-life"></select></label>
                    </div>
                    <div class="mj-craft-dice">
                        <label class="mj-ship-toggle"><input type="checkbox" id="mj-craft-roll"> Lancer le dé de réussite</label>
                        <span class="mj-craft-chance" id="mj-craft-chance"></span>
                    </div>
                    <small class="mj-craft-fail" id="mj-craft-fail"></small>
                    <div class="mj-ship-subtitle">Recettes</div>
                    <div class="mj-craft-recipes" id="mj-craft-recipes"></div>
                    <div class="mj-shop-msg" id="mj-craft-msg" role="status"></div>
                </div>
                <div class="mj-craft-col">
                    <div class="mj-ship-subtitle">Assemblage libre</div>
                    <p class="mj-ship-help">Assemblez des objets de l'artisan et décidez du résultat (un objet du catalogue ou un nouveau nom).</p>
                    <div class="mj-craft-free-add">
                        <select id="mj-craft-free-item" class="add-life" aria-label="Ingrédient"></select>
                        <input type="number" id="mj-craft-free-qty" class="add-life" min="1" max="99" value="1" aria-label="Quantité">
                        <button type="button" class="add-life" id="mj-craft-free-add" title="Ajouter l'ingrédient">+</button>
                    </div>
                    <div class="mj-craft-free-list" id="mj-craft-free-list"></div>
                    <div class="mj-craft-free-result">
                        <input type="text" id="mj-craft-result" class="add-life" list="mj-craft-results" maxlength="60" placeholder="Objet obtenu">
                        <input type="number" id="mj-craft-result-qty" class="add-life" min="1" max="99" value="1" aria-label="Exemplaires obtenus">
                    </div>
                    <datalist id="mj-craft-results"></datalist>
                    <button type="button" class="add-life fight" id="mj-craft-free-make" disabled>Assembler</button>
                    <div class="mj-ship-subtitle">Journal</div>
                    <div class="mj-shop-log" id="mj-craft-log"></div>
                </div>
            </section>
        </div>
    </div>
<script>var BESTIARY = <%- JSON.stringify(locals.bestiary || []).replace(/</g, '\\u003c') %>;
var COMPANIONS = <%- JSON.stringify(locals.companions || []).replace(/</g, '\\u003c') %>;
var STATUSES = <%- JSON.stringify(locals.statuses || []).replace(/</g, '\\u003c') %>;
var SHIP_ROOMS = <%- JSON.stringify(locals.shipRooms || []).replace(/</g, '\\u003c') %>;</script>
<datalist id="loot-list">
    <% (locals.loot || []).forEach(function(item) { %>
    <option value="<%= item.name %>" data-qty="<%= item.qty || 1 %>"></option>
    <% }); %>
</datalist>
<script src="js/mj-menu.js"></script>
<script src="js/combat-text.js"></script>
<script src="js/mj-combat.js"></script>
<script src="js/mj-allies.js"></script>
<script src="js/ship-map.js"></script>
<script src="js/mj-ship.js"></script>
<script src="js/mj-shop.js"></script>
<script src="js/mj-craft.js"></script>
<%- include("partials/bottom-scripts") %>
</body>