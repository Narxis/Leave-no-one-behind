<div id="player-tab<%= friend.id %>" class="player-tab move-up load-in">
    <div class="expander">?</div>
    <div class="expander-item">
        <img src="img/chest.png" alt="chest" class="chestimg">
        <div class="itemlist" id="item<%= friend.id %>">
        <% if(friend.items){ %>
            <% friend.items.forEach(function(item) { %>
                <div class="itemlist-line <%= item.slug %>">
                    <p><%= item.name %></p>
                    <i onclick="removeStarterItem('<%= friend.id %>', '<%= item.slug %>')" class="far fa-trash-alt item-trash"></i>
                </div>
            <% }); %>
        <% } %>
        </div>
    </div>
    <div class="player-roll">
        <div class="player-name"><%= friend.name %>
            <div class="player-race">(<%= friend.race %>)</div>
        </div>
