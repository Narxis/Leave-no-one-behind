<div class="player" id="p<%= player.discord_id %>" data-race="<%= player.race || '' %>">
    <input type="text" placeholder="Nom du joueur" class="player-name" value="<%= player.name %>">
    <img src="/img/races/<%= player.race %>.png" alt="" onerror="this.src='/img/races/wat.png'" class="race-img">
    <div class="race-selector-container">
        <div class="select-affichage"></div>
        <div class="options-affichage">
            <% races.forEach(function (race) { %>
                <li class="race-possible" data-name="<%= race.slug %>"><%= race.name %></li>
            <% }); %>
        </div>
    </div>
    <div class="player-stats">
        <hr class="separateur">
        <div class="player-stat" id="combat">
            <div class="player-stat-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 70 384 512">
                    <path
                        d="M160 0c17.7 0 32 14.3 32 32V144H128V32c0-17.7 14.3-32 32-32zM32 64c0-17.7 14.3-32 32-32s32 14.3 32 32v80H32V64zm192 0c0-17.7 14.3-32 32-32s32 14.3 32 32v96c0 17.7-14.3 32-32 32s-32-14.3-32-32V64zm96 64c0-17.7 14.3-32 32-32s32 14.3 32 32v64c0 17.7-14.3 32-32 32s-32-14.3-32-32V128zm-96 88l0-.6c9.4 5.4 20.3 8.6 32 8.6c13.2 0 25.4-4 35.6-10.8c8.7 24.9 32.5 42.8 60.4 42.8c11.7 0 22.6-3.1 32-8.6V256c0 52.3-25.1 98.8-64 128v96c0 17.7-14.3 32-32 32H128c-17.7 0-32-14.3-32-32V401.6c-17.3-7.9-33.2-18.8-46.9-32.5L37.5 357.5C13.5 333.5 0 300.9 0 267V240c0-35.3 28.7-64 64-64h88c22.1 0 40 17.9 40 40s-17.9 40-40 40H96c-8.8 0-16 7.2-16 16s7.2 16 16 16h56c39.8 0 72-32.2 72-72z" />
                </svg>
            </div>
            <input type="number" name="stat-combat[<%= player.discord_id %>]" class="player-stat-value"
                value="<%= player.combat > 0 ? player.combat : '' %>">
        </div>
        <hr class="separateur">
        <div class="player-stat" id="pilotage">
            <div class="player-stat-icon">
                <svg id="Calque_1" data-name="Calque 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 193 193">
                    <path
                        d="M188.39,96.5c0,27.1-19.86,50.64-49,62.47a4.36,4.36,0,0,1-6-4v-5.26a4.35,4.35,0,0,1,2.47-3.92c18.08-8.55,31.09-22.81,34.77-39.51a4.34,4.34,0,0,0-4.27-5.24H135.55a4.38,4.38,0,0,0-3.47,1.72L107.29,135.3a4.35,4.35,0,0,1-3.43,1.72l-12.74.11a4.36,4.36,0,0,1-3.44-1.63L60.19,101.15V101H26.65a4.38,4.38,0,0,0-4.26,5.35c3.76,16.82,17,31.15,35.3,39.66a4.34,4.34,0,0,1,2.5,3.94v5.2a4.37,4.37,0,0,1-6,4.06C24.74,147.46,4.61,123.78,4.61,96.5s20.13-51,49.6-62.71a4.37,4.37,0,0,1,6,4.06v5.2A4.34,4.34,0,0,1,57.69,47c-15,7-26.65,17.9-32.41,30.89a4.37,4.37,0,0,0,4,6.12H57.44a4.34,4.34,0,0,0,3.87-2.35c2.94-5.81,7.56-9.33,14.66-9.5L118,72c6.29.13,11.26,2.89,14.39,9.49A4.36,4.36,0,0,0,136.3,84h27.41a4.37,4.37,0,0,0,4-6.11C162,65.05,150.65,54.24,135.87,47.25a4.34,4.34,0,0,1-2.48-3.93V38.07a4.36,4.36,0,0,1,6-4C168.53,45.86,188.39,69.4,188.39,96.5Z"
                        transform-origin="center" />
                </svg>
            </div>
            <input type="number" name="stat-pilotage[<%= player.discord_id %>]" class="player-stat-value"
                value="<%= player.pilotage > 0 ? player.pilotage : '' %>">
        </div>
        <hr class="separateur">
        <div class="player-stat" id="engineering">
            <div class="player-stat-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
                    <path
                        d="M352 320c88.4 0 160-71.6 160-160c0-15.3-2.2-30.1-6.2-44.2c-3.1-10.8-16.4-13.2-24.3-5.3l-76.8 76.8c-3 3-7.1 4.7-11.3 4.7H336c-8.8 0-16-7.2-16-16V118.6c0-4.2 1.7-8.3 4.7-11.3l76.8-76.8c7.9-7.9 5.4-21.2-5.3-24.3C382.1 2.2 367.3 0 352 0C263.6 0 192 71.6 192 160c0 19.1 3.4 37.5 9.5 54.5L19.9 396.1C7.2 408.8 0 426.1 0 444.1C0 481.6 30.4 512 67.9 512c18 0 35.3-7.2 48-19.9L297.5 310.5c17 6.2 35.4 9.5 54.5 9.5zM80 456c-13.3 0-24-10.7-24-24s10.7-24 24-24s24 10.7 24 24s-10.7 24-24 24z" />
                </svg>
            </div>
            <input type="number" id="stat-ingenierie[<%= player.discord_id %>]" class="player-stat-value"
                value="<%= player.engineering > 0 ? player.engineering : '' %>">
        </div>
        <hr class="separateur">
        <div class="player-stat" id="survival">
            <div class="player-stat-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512">
                    <path
                        d="M377 52c11-13.8 8.8-33.9-5-45s-33.9-8.8-45 5L288 60.8 249 12c-11-13.8-31.2-16-45-5s-16 31.2-5 45l48 60L12.3 405.4C4.3 415.4 0 427.7 0 440.4V464c0 26.5 21.5 48 48 48H288 528c26.5 0 48-21.5 48-48V440.4c0-12.7-4.3-25.1-12.3-35L329 112l48-60zM288 448H168.5L288 291.7 407.5 448H288z" />
                </svg>
            </div>
            <input type="number" name="stat-survie[<%= player.discord_id %>]" class="player-stat-value"
                value="<%= player.survival > 0 ? player.survival : '' %>">
        </div>
        <hr class="separateur">
        <div class="player-stat" id="recon">
            <div class="player-stat-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
                    <path
                        d="M128 32h32c17.7 0 32 14.3 32 32V96H96V64c0-17.7 14.3-32 32-32zm64 96V448c0 17.7-14.3 32-32 32H32c-17.7 0-32-14.3-32-32V388.9c0-34.6 9.4-68.6 27.2-98.3C40.9 267.8 49.7 242.4 53 216L60.5 156c2-16 15.6-28 31.8-28H192zm227.8 0c16.1 0 29.8 12 31.8 28L459 216c3.3 26.4 12.1 51.8 25.8 74.6c17.8 29.7 27.2 63.7 27.2 98.3V448c0 17.7-14.3 32-32 32H352c-17.7 0-32-14.3-32-32V128h99.8zM320 64c0-17.7 14.3-32 32-32h32c17.7 0 32 14.3 32 32V96H320V64zm-32 64V288H224V128h64z" />
                </svg>
            </div>
            <input type="number" name="stat-reconnaissance[<%= player.discord_id %>]" class="player-stat-value"
                value="<%= player.recon > 0 ? player.recon : '' %>">
        </div>
        <hr class="separateur">
        <div class="player-stat" id="moral">
            <div class="player-stat-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 384 512">
                    <path
                        d="M256 64c0-35.3-28.7-64-64-64s-64 28.7-64 64s28.7 64 64 64s64-28.7 64-64zM152.9 169.3c-23.7-8.4-44.5-24.3-58.8-45.8L74.6 94.2C64.8 79.5 45 75.6 30.2 85.4s-18.7 29.7-8.9 44.4L40.9 159c18.1 27.1 42.8 48.4 71.1 62.4V480c0 17.7 14.3 32 32 32s32-14.3 32-32V384h32v96c0 17.7 14.3 32 32 32s32-14.3 32-32V221.6c29.1-14.2 54.4-36.2 72.7-64.2l18.2-27.9c9.6-14.8 5.4-34.6-9.4-44.3s-34.6-5.5-44.3 9.4L291 122.4c-21.8 33.4-58.9 53.6-98.8 53.6c-12.6 0-24.9-2-36.6-5.8c-.9-.3-1.8-.7-2.7-.9z" />
                </svg>
            </div>
            <input type="number" name="stat-moral[<%= player.discord_id %>]" class="player-stat-value"
                value="<%= player.moral > 0 ? player.moral : '' %>">
        </div>
    </div>
    <div class="race-desc"></div>
</div>

