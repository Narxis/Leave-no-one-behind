<head>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/parallax.css">
</head>
<body>
<section class="main">
    <div class="wrap wrap--1">
        <div class="container container--1">
            <div class="dot">
                <h1 class="card-text title"><%= event.name %></h1>
                <p class="card-text desc"><%= event.desc %></p>
                <div class="buttons">
                    <% for(var i=0; i < event.choices.length ; i++) {%>
                        <button><%= event.choices[i] %></button>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</section>
</body>

<!--<script src="/js/parallax.js"></script>-->
<script src="/js/scramble.js"></script>
<script>
    const title = document.querySelector(".title");
    const desc = document.querySelector(".desc");
    const fxt = new TextScramble(title);
    const fxd = new TextScramble(desc);

    document.addEventListener('mouseup', function (){
        fetch('/randCard?json=1')
            .then(resp => {
                return resp.json()
            })
            .then(data => {
                console.log(data)
                fxt.setText(data.name);
                fxd.setText(data.desc);
            })
    })
</script>