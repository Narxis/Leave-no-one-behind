<head>
    <link rel="stylesheet" href="/css/parallaxe.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/d3/3.5.16/d3.min.js"></script>
</head>
<body class="wrap--1">
<form class="card edit" method="post">
    <div class="wrap wrap--1">
        <div class="mod-stats" id="modtab">
            <input class="tab tab-moteurs move-right"  id="create" type="submit" value="OK">
        </div>
        <div class="choices" id="choicetab">
            <textarea name="choices[]" class="choice move-down">Choix n°1</textarea>
            <textarea name="choices[]" class="choice move-down">Choix n°2</textarea>
            <div class="choice move-down" style="background-color: #2F1F3D;" id="add_choice">+</div>
            <!--          <div class="choice move-down" id="choice4"></div>-->
        </div>
        <div class="timertab" style="transform: rotate(0deg); !important;">
            <input name="timer" type="number" value="0" class="container-timer">
        </div>
        <div class="container-card container--1">
            <div class="bg-dot"></div>
            <textarea name="desc" class="card-text">Description de la carte</textarea>
        </div>
    </div>
</form>
</body>

<style>
    form.card.edit input,
    form.card.edit textarea {
        background: #fff3;
        resize: none;
    }
    form.card.edit input,
    form.card.edit textarea.choice {
        background-color: #2F1F3D;
        font-family: inherit;
        font-size: inherit;
        display: inherit;
        text-align: center;
        color: inherit;
        margin: inherit;
    }
    form.card.edit input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }
    /* Firefox */
    form.card.edit input[type=submit] {
        text-align: right;
        padding: 0 22px;
        cursor: pointer;
    }
    form.card.edit input[type=submit]:hover {
        background: #0f03;
    }
    form.card.edit input[type=number] {
        -moz-appearance: textfield;
        font-size: 24px;
    }
    .container-timer {
        top: 2px;
        left: 2px;
        width: 76px;
        height: 76px;
        border-radius: 50%;
        border: 4px solid cyan;
    }
</style>

<script src="/js/slidingtabs.js"></script>
<script src="/js/dial/dial.js"></script>
<script>
    let dials = document.getElementsByClassName("dial");
    for (let i = 0; i < dials.length; i++) {
        let dial = new Dial(dials.item(i));
        dial.animateStart();
    }

    document.getElementById('add_choice').addEventListener('mouseup', function () {
        let choices = document.querySelectorAll('textarea.choice');
        console.log(choices.item(1))
        if (choices.length < 4){
            let clone = choices.item(choices.length - 1).cloneNode();
            clone.innerText = 'Choix n°' +  (1 + choices.length)
            document.getElementById('choicetab').insertBefore(clone, this);
            if (choices.length === 3) {
                this.remove()
            }
        }
    });
</script>
