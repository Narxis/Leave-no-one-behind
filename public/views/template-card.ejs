<script>
  var cardtextstr = `<%- card.desc %>`;
  var choicelist = [];
  var answerlist = [];
  <% card.choices.forEach(function(choice) {%>
    choicelist.push(`<%- choice.value %>`);
    answerlist.push(`<%- choice.reveal %>`);
    <% }); %>
