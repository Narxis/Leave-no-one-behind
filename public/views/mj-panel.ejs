<html lang="fr" translate="no">
<%- include("partials/head", { title: "MJ Menu2" , cssFiles:[ "/css/style.css" , "/css/mj-panel.css" ] }) %>

    <body>
        <%- include("partials/nav") %>
            <div class="center">
                <div class="mj-box">
                    <div class="roll-box">
                        <div class="box1">
                            <div class="box1-1">
                                <ul class="deroulant" id="roll-type-selector">
                                    <li>Type de roll</li>
                                    <ul class="sous">
                                        <li>Moral (faible)</li>
                                        <li>Moral (moyen)</li>
                                        <li>Dégats module (faible)</li>
                                        <li>Dégats module (moyen)</li>
                                        <li>Dégats module (fort)</li>
                                        <li>Gain de stat (faible)</li>
                                        <li>Gain de stat (moyen)</li>
                                        <li>Gain de stat (fort)</li>
                                        <li>Action Compagnon/Adversaire</li>
                                        <li>D2</li>
                                    </ul>
                                </ul>
                                <form>
                                    <fieldset>
                                        <legend>Cible du roll</legend>

                                        <input type="radio" id="roll-type-none" name="roll-type-target" checked>
                                        <label for="roll-type-none">Aucune cible</label><br>

                                        <input type="radio" id="roll-type-friend1" name="roll-type-target">
                                        <label for="roll-type-friend1">Friend 1</label><br>

                                        <input type="radio" id="roll-type-foe1" name="roll-type-target">
                                        <label for="roll-type-foe1">Foe 1</label><br>

                                        <input type="radio" id="roll-type-foe2" name="roll-type-target">
                                        <label for="roll-type-foe2">Foe 2</label><br>

                                        <input type="radio" id="roll-type-foe3" name="roll-type-target">
                                        <label for="roll-type-foe3">Foe 3</label><br>

                                        <input type="radio" id="roll-type-mod" name="roll-type-target">
                                        <label for="roll-type-mod">Module(s)</label><br>

                                        <input type="checkbox" id="roll-type-mod1" name="roll-type-target-mod">
                                        <label for="roll-type-mod1">Moteurs</label><br>

                                        <input type="checkbox" id="roll-type-mod2" name="roll-type-target-mod">
                                        <label for="roll-type-mod2">Scanner de surface</label><br>

                                        <input type="checkbox" id="roll-type-mod3" name="roll-type-target-mod">
                                        <label for="roll-type-mod3">Détecteur de proximité</label><br>

                                        <input type="checkbox" id="roll-type-mod4" name="roll-type-target-mod">
                                        <label for="roll-type-mod4">Oxygène</label><br>

                                        <input type="checkbox" id="roll-type-mod5" name="roll-type-target-mod">
                                        <label for="roll-type-mod5">Electricité</label><br>

                                        <input type="checkbox" id="roll-type-mod6" name="roll-type-target-mod">
                                        <label for="roll-type-mod6">Gravité artificielle</label><br>

                                        <input type="checkbox" id="roll-type-mod7" name="roll-type-target-mod">
                                        <label for="roll-type-mod7">Tout les modules</label><br>
                                    </fieldset>
                                </form>
                            </div>
                            <div class="box1-2">
                                <ul class="deroulant" id="roll-modifier">
                                    <li>Roll Simple (0)</li>
                                    <ul class="sous">
                                        <li>Roll Désavantage 2 (-2)</li>
                                        <li>Roll Désavantage 1 (-1)</li>
                                        <li>Roll Avantage 1 (+1)</li>
                                        <li>Roll Avantage 2 (+2)</li>
                                    </ul>
                                </ul>
                                <form>
                                    <fieldset>
                                        <legend>Statistique à roll</legend>

                                        <input type="radio" id="roll-target1" name="roll-stat-target" checked>
                                        <label for="roll-target1">Aucune statistique</label><br>

                                        <input type="radio" id="roll-target2" name="roll-stat-target">
                                        <label for="roll-target2">Combat</label><br>

                                        <input type="radio" id="roll-target3" name="roll-stat-target">
                                        <label for="roll-target3">Force</label><br>

                                        <input type="radio" id="roll-target4" name="roll-stat-target">
                                        <label for="roll-target4">Pilotage</label><br>

                                        <input type="radio" id="roll-target5" name="roll-stat-target">
                                        <label for="roll-target5">Dextérité</label><br>

                                        <input type="radio" id="roll-target6" name="roll-stat-target">
                                        <label for="roll-target6">Ingéniérie</label><br>

                                        <input type="radio" id="roll-target7" name="roll-stat-target">
                                        <label for="roll-target7">Intelligence</label><br>

                                        <input type="radio" id="roll-target8" name="roll-stat-target">
                                        <label for="roll-target8">Constitution</label><br>

                                        <input type="radio" id="roll-target9" name="roll-stat-target">
                                        <label for="roll-target9">Survie</label><br>

                                        <input type="radio" id="roll-target10" name="roll-stat-target">
                                        <label for="roll-target10">Reconnaissance</label><br>

                                        <input type="radio" id="roll-target11" name="roll-stat-target">
                                        <label for="roll-target11">Charisme</label><br>
                                    </fieldset>
                                </form>
                            </div>
                        </div>
                        <div class="box2">
                            <button class="mod-b" id="mjroll-button">Roll</button>
                            <button class="mod-b send" id="mjroll-send">Send</button>
                            <div id="mjroll-roll">00</div>
                        </div>
                    </div>
                    <div class="choice-box">
                        <div class="box1">
                            <div class="choice-reveal">
                                <div class="">
                                    <div class="">&nbsp;&nbsp;<span class="blackout">Blackout</span>&nbsp;-&nbsp;<span
                                            class="mjreveal">Infos-MJ</span><br><br>&nbsp;&nbsp;&nbsp;Description de la
                                        carte actuelle :
                                    </div>
                                    <div class=""></div>
                                    <div class="">Ici serra présenté le texte descriptif de la carte actuelle, certaines
                                        informations ne seront visible qu'ici !</div>
                                </div>
                                <% for(var i=0; i<3; i++) {%>
                                    <div class="choice" id="choice<%= i %>">
                                        <div class="">Ici serront présentés les choix. <span class="blackout">Les choix
                                                pendant un blackout.</span></div>
                                        <div class=""></div>
                                        <div class="">Ici serra présenté le texte révélé après avoir cliqué sur le
                                            choix.<span class="blackout">&nbsp;Les outcome pendant un
                                                blackout,</span><span class="mjreveal"> et les informations
                                                complémentaires.</span></div>
                                    </div>
                                    <% } %>
                            </div>
                        </div>
                        <div class="box2">
                            <ul class="deroulant" id="status">
                                <li>Status</li>
                                <ul class="sous">
                                    <li>Blackout</li>
                                    <li>Anticipation</li>
                                    <li>Rechérché</li>
                                </ul>
                            </ul>
                            <input type="number" min="0" max="10" class="" id="duration-status" placeholder="0"></input>
                            <button class="mod-b send" id="add-status">Send</button>
                        </div>
                    </div>
                    <div class="combat-box">
                        <div class="box1">
                            <div class="box1-1">
                                <input type="radio" id="add-type-friend" name="add-type" checked>
                                <label for="add-type-friend">Compagnon</label>

                                <input type="radio" id="add-type-foe" name="add-type">
                                <label for="add-type-foe">Ennemi</label>

                                <form>
                                    <fieldset>
                                        <legend>Bestiaire</legend>

                                        <%- include("partials/bestiaire") %>
                                    </fieldset>
                                </form>
                            </div>
                            <div class="box1-2">
                                <div class="legende">Statistique (pour les compagnons)</div>
                                <button class="mod-b send">Send</button>

                                <form>
                                    <fieldset>
                                        <legend>Statistique à roll</legend>

                                        <input type="radio" id="roll-friend-stat1" name="friend-stat" checked>
                                        <label for="roll-friend-stat1">Combat</label><br>

                                        <input type="radio" id="roll-friend-stat2" name="friend-stat">
                                        <label for="roll-friend-stat2">Pilotage</label><br>

                                        <input type="radio" id="roll-friend-stat3" name="friend-stat">
                                        <label for="roll-friend-stat3">Ingéniérie</label><br>

                                        <input type="radio" id="roll-friend-stat4" name="friend-stat">
                                        <label for="roll-friend-stat4">Survie</label><br>

                                        <input type="radio" id="roll-friend-stat5" name="friend-stat">
                                        <label for="roll-friend-stat5">Reconnaissance</label><br>
                                    </fieldset>
                                </form>
                            </div>
                        </div>
                        <div class="box2">
                            <button class="mod-b">Commencer le combat</button>
                        </div>
                    </div>
                </div>
            </div>
            <script src="js/socketLNOB.js"></script>
            <script src="js/mj-panel.js"></script>
            <%- include("partials/bottom-scripts") %>
    </body>