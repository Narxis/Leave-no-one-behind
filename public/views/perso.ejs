<%- include("partials/head", {
    title: "Création des persos",
    cssFiles:[
        "/css/style.css",
        "/css/perso.css",
        "/css/ui-menus.css",
        "/css/parametres.css"
    ]
}) %>

<body>
    <%- include("partials/nav") %>
    <div class="leftcenter">
        <div class="legend-stack">
            <%- include("partials/stats-legend") %>
            <button type="button" class="stats-rules-open" id="stats-rules-open">Comment sont tirées les stats ?</button>
        </div>
    </div>
    <div class="center">
        <div class="lecadre">Pour rejoindre la partie tappez "/join" sur discord, puis créez votre personnage avec
            "/create"</div>
        <div class="container-player" id="players_create"></div>
    </div>
    <div class="topcenter">
        <div class="bouton-suivant" id="start-game" role="button" tabindex="0">Commencer la partie</div>
    </div>

    <%# Avant de commencer : le MJ nomme l'équipe, pour le classement de fin de partie %>
    <dialog class="team-dialog" id="team-dialog" aria-labelledby="team-dialog-title">
        <form method="dialog" class="team-form" id="team-form">
            <h2 class="team-dialog-title" id="team-dialog-title">Nom de l'équipe</h2>
            <p class="team-dialog-text">Il apparaîtra au classement avec le score de la partie.</p>
            <input class="team-input" id="team-name" type="text" maxlength="40" autocomplete="off" required
                   placeholder="Les Explorateurs de Kepler…" aria-label="Nom de l'équipe">
            <p class="team-error" id="team-error" role="alert"></p>
            <div class="team-settings"><%- include("partials/settings-recap", {settings: settings, editLink: true}) %></div>
            <div class="team-actions">
                <button type="button" class="team-cancel" id="team-cancel">Annuler</button>
                <button type="submit" class="team-submit">Commencer la partie</button>
            </div>
        </form>
    </dialog>

    <%# Règle du tirage des stats (même calcul que le bouton roll-stats du bot) %>
    <%
        const STAT_COLS = [['combat', 'Combat'], ['pilotage', 'Pilotage'], ['engineering', 'Ingénierie'],
            ['survival', 'Survie'], ['recon', 'Recon.']];
        // Valeur moyenne de la stat finale : 50 + le meilleur (bonus) ou le pire (malus) de |mod| + 1 dés de 50
        const average = (mod) => {
            let k = Math.abs(mod) + 1, sum = 0;
            for (let v = 1; v <= 50; v++) {
                let p = mod >= 0 ? Math.pow(v / 50, k) - Math.pow((v - 1) / 50, k)
                    : Math.pow((51 - v) / 50, k) - Math.pow((50 - v) / 50, k);
                sum += v * p;
            }
            return Math.round(50 + sum);
        };
        const signed = (mod) => mod > 0 ? '+' + mod : String(mod);
        const raceName = (r) => r.charAt(0).toUpperCase() + r.slice(1).replace('_', '-');
    %>
    <dialog class="stats-rules" id="stats-rules" aria-labelledby="stats-rules-title">
        <div class="stats-rules-head">
            <h2 class="stats-rules-title" id="stats-rules-title">Répartition des stats</h2>
            <button type="button" class="stats-rules-close" id="stats-rules-close" aria-label="Fermer">×</button>
        </div>
        <div class="stats-rules-body">
            <p>Chaque stat vaut <b>50 + un dé de 50</b>, donc entre 51 et 100. La race donne à chaque stat un bonus ou un malus qui change le nombre de dés lancés avec <b>/create</b> :</p>
            <table class="stats-rules-table stats-rules-mods">
                <thead>
                    <tr><th scope="col">Bonus de race</th><th scope="col">Dés lancés</th><th scope="col">Dé gardé</th><th scope="col" class="num">Moyenne</th></tr>
                </thead>
                <tbody>
                    <% [2, 1, 0, -1, -2].forEach(function (mod) { %>
                        <tr>
                            <td><span class="stats-mod mod-<%= mod < 0 ? 'm' + -mod : mod %>"><%= signed(mod) %></span></td>
                            <td><%= Math.abs(mod) + 1 %></td>
                            <td><%= mod > 0 ? 'le meilleur' : mod < 0 ? 'le pire' : 'le seul' %></td>
                            <td class="num"><%= average(mod) %></td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
            <p class="stats-rules-note">Le moral part toujours à 100.</p>

            <h3 class="stats-rules-sub">Bonus et malus par race</h3>
            <div class="stats-rules-scroll">
                <table class="stats-rules-table stats-rules-races">
                    <thead>
                        <tr>
                            <th scope="col">Race</th>
                            <% STAT_COLS.forEach(function (col) { %><th scope="col" class="num"><%= col[1] %></th><% }); %>
                        </tr>
                    </thead>
                    <tbody>
                        <% races.forEach(function (race) { %>
                            <tr>
                                <th scope="row"><%= race.name %><% if (race.custom) { %> <span class="stats-custom">custom</span><% } %></th>
                                <% STAT_COLS.forEach(function (col) { let mod = parseInt(race.stats[col[0]]) || 0; %>
                                    <td class="num" title="Moyenne <%= average(mod) %>">
                                        <span class="stats-mod mod-<%= mod < 0 ? 'm' + -mod : mod %>"><%= signed(mod) %></span>
                                        <span class="stats-avg">≈<%= average(mod) %></span>
                                    </td>
                                <% }); %>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    </dialog>

    <script src="/js/perso.js"></script>
    <script>
        (function () {
            const dialog = document.getElementById('stats-rules');
            document.getElementById('stats-rules-open').addEventListener('click', () => dialog.showModal());
            document.getElementById('stats-rules-close').addEventListener('click', () => dialog.close());
            // Clic en dehors de la fenêtre : elle se ferme
            dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
        })();
    </script>

    <script>
        loadPlayerSheets();

        (function () {
            const dialog = document.getElementById('team-dialog');
            const input = document.getElementById('team-name');
            const error = document.getElementById('team-error');
            const open = () => {
                error.textContent = '';
                // Nom de l'équipe précédente proposé par défaut
                fetch('/api/team').then(r => r.json()).then(team => {
                    if (team && team.team && !input.value)
                        input.value = team.team;
                    input.select();
                }).catch(() => {});
                dialog.showModal();
                input.focus();
            };
            let button = document.getElementById('start-game');
            button.addEventListener('click', open);
            button.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); } });
            document.getElementById('team-cancel').addEventListener('click', () => dialog.close());
            document.getElementById('team-form').addEventListener('submit', async (e) => {
                e.preventDefault();
                let name = input.value.trim();
                if (!name) {
                    error.textContent = 'Entrez un nom d\'équipe.';
                    input.focus();
                    return;
                }
                try {
                    let res = await fetch('/api/team', {
                        method: 'POST',
                        headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify({name: name})
                    });
                    if (!res.ok)
                        throw new Error();
                    location.href = '/synopsis';
                }
                catch (err) {
                    error.textContent = 'Impossible d\'enregistrer le nom, réessayez.';
                }
            });
        })();
    </script>
    <%- include("partials/bottom-scripts") %>
</body>